{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bfl.example/schemas/rag/ranking-record.schema.json",
  "title": "Protected RAG Ranking Record",
  "description": "Identity-only per-query ranking. No question, content, principal, or score fields are permitted.",
  "type": "object",
  "additionalProperties": false,
  "required": ["queryId", "retrievedContext"],
  "properties": {
    "queryId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,199}$"
    },
    "retrievedContext": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["documentItemId", "pageNumber"],
        "properties": {
          "documentItemId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "pageNumber": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
